#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200  // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 25   // 10

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <behaviors/runtime-sensor-rotate.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <1>;      // 0
    time-to-max-speed-ms = <100>;       // 300
    delay-ms = <0>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

&soft_off { hold-time-ms = <2000>; };

&mt {
    flavor = "tap-preferred";
    tapping-term-ms = <175>;
};

&lt {
    flavor = "tap-preferred";
    tapping-term-ms = <175>;
};

/ {
    scroll_encoder: scroll_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

        tap-ms = <100>;
    };

    behaviors {
        rsr_vol: rsr_vol {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <5>;
            cw-binding = <&kp C_VOL_UP>;
            ccw-binding = <&kp C_VOL_DN>;
        };

        rsr_trans: rsr_trans {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <0>;
        };

        scroll_lr: scroll_lr {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_RIGHT>, <&msc SCRL_LEFT>;
        };

        scroll_ud: scroll_ud {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_UP>, <&msc SCRL_DOWN>;
        };
    };

    combos {
        compatible = "zmk,combos";

        softoff {
            bindings = <&soft_off>;
            key-positions = <14 28 40>;
        };
    };

    macros {
        SHIFT_MCLK: SHIFT_MCLK {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_SHIFT>,
                <&macro_press>,
                <&mkp MB3>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&kp LEFT_SHIFT &mkp MB3>;

            label = "SHIFT_MCLK";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        layer0 {
            bindings = <
                &kp ESC      &kp N1      &kp N2      &kp N3       &kp N4        &kp N5  &kp LC(LA(TAB))    &kp N6      &kp N7        &kp N8       &kp N9      &kp N0      &kp DEL
                &kp TAB      &kp Q       &kp W       &kp E        &kp R         &kp T   &kp ESC            &kp Y       &kp U         &kp I        &kp O       &kp P       &kp BSPC
                &kp ESC      &mt LGUI A  &mt LALT S  &mt LCTRL D  &mt LSHIFT F  &kp G   &kp LEFT           &kp H       &mt LSHIFT J  &mt LCTRL K  &mt LALT L  &mt LGUI Z  &kp ENTER
                &kp LCTRL    &kp Z       &kp X       &kp C        &kp V         &kp B   &kp RIGHT          &kp N       &kp M         &kp COMMA   &kp PERIOD   &mo 3       &mo 4
                &kp K_CMENU  &none       &none       &kp TAB      &mo 2         &mo 1   &none              &kp LSHIFT  &lt 3 SPACE   &kp BSPC     &kp DEL     &none
            >;

            sensor-bindings = <&scroll_lr &rsr_trans>;
            display-name = "LAYER0_BASE";
        };


        layer_1 {
            bindings = <
                &trans  &kp F1       &kp F2          &kp F3          &kp F4            &kp F5     &trans    &kp F6     &kp F7            &kp F8          &kp F9         &kp F10       &trans
                &trans  &kp CARET    &kp LT          &kp GT          &kp HASH          &kp PRCNT  &trans    &kp AMPS   &kp DQT           &kp LBKT        &kp RBKT       &kp BSLH      &trans
                &trans  &mt LGUI AT  &mt LALT MINUS  &mt LCTRL PLUS  &mt LSHIFT EQUAL  &kp DLLR   &trans    &kp PIPE   &mt LSHIFT UNDER  &mt LCTRL LPAR  &mt LALT RPAR  &mt LGUI SQT  &trans
                &trans  &kp EXCL     &kp SLASH       &kp ASTRK       &kp SEMI          &kp GRAVE  &trans    &kp TILDE  &kp COLON         &kp LBRC        &kp RBRC       &kp QMARK     &trans
                &trans  &trans       &trans          &trans          &trans            &trans     &trans    &trans     &trans            &trans          &trans         &trans
            >;

            sensor-bindings = <&scroll_lr &rsr_trans>;
            display-name = "LAYER1_SYM";
        };

        layer_2 {
            bindings = <
                &bt BT_CLR  &bt BT_SEL 0   &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &trans    &out OUT_TOG  &out OUT_BLE  &out OUT_USB  &none      &none   &none
                &trans      &kp LS(LG(S))  &none         &kp LS(F10)   &none         &none         &trans    &kp HOME      &kp PG_DN     &kp PG_UP     &kp END    &none   &trans
                &trans      &kp LGUI       &kp LALT      &kp LCTRL     &kp LSHIFT    &none         &trans    &kp LEFT      &kp DOWN      &kp UP        &kp RIGHT  &none   &kp ENTER
                &trans      &none          &none         &none         &none         &none         &trans    &none         &kp ENTER     &kp ESC       &kp TAB    &none   &trans
                &trans      &trans         &trans        &trans        &trans        &trans        &trans    &kp DEL       &kp BSPC      &kp BSPC      &trans     &trans
            >;

            sensor-bindings = <&scroll_lr &rsr_trans>;
            display-name = "LAYER2_NAV";
        };

        layer_3 {
            bindings = <
                &none   &none       &none   &none   &none   &none      &trans    &none   &none       &none       &none     &none     &none
                &trans  &none       &kp N7  &kp N8  &kp N9  &kp TAB    &trans    &none   &none       &none       &none     &none     &trans
                &trans  &kp PERIOD  &kp N4  &kp N5  &kp N6  &kp N0     &trans    &none   &kp LSHIFT  &kp LCTRL  &kp LALT  &kp LGUI  &trans
                &trans  &none       &kp N1  &kp N2  &kp N3  &kp ENTER  &trans    &none   &kp LSHIFT  &kp LCTRL  &kp LALT  &none     &trans
                &trans  &none       &none   &kp N0  &kp N0  &trans     &trans    &trans  &trans      &trans      &trans    &trans
            >;

            sensor-bindings = <&scroll_lr &rsr_trans>;
            display-name = "LAYER3_NUM";
        };


        layer_4 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
            >;

            display-name = "LAYER4";
            sensor-bindings = <&rsr_vol &rsr_trans>;
        };
    };
};
